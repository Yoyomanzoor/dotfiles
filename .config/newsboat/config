# Newsboat configuration file
# See `man newsboat` for documentation
# Yoyomanzoor

reload-time 3600
browser "vieb %u"
include /usr/share/doc/newsboat/contrib/colorschemes/inkpot
goto-next-feed no
show-read-feeds yes

# bind keys - vim style
unbind-key j
unbind-key k
unbind-key l
unbind-key h
bind j everywhere down
bind k everywhere up
bind ^b everywhere pageup
bind ^f everywhere pagedown
bind ^d everywhere halfpagedown
bind ^u everywhere halfpageup

unbind-key g
unbind-key G
bind gg everywhere home
bind G everywhere end
bind gs everywhere sort
bind gr everywhere rev-sort
bind ^i everywhere prev-dialog
bind ^o everywhere next-dialog

bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key l open
bind-key h quit

macro p set browser "boatreader %u"; open-in-browser; set browser "vieb %u"
macro w set browser "w3m %u"; open-in-browser; set browser "vieb %u"
macro l set browser "lynx %u"; open-in-browser; set browser "vieb %u"
macro o set browser "vieb %u"; open-in-browser

bookmark-cmd bookmarks
bookmark-interactive no
bookmark-autopilot yes
save-path ~/.local/share/rss/

# errors
error-log ~/.config/newsboat/error.log

# heading
highlight feedlist "----.*----" yellow default bold
highlight feedlist ".*0/0.." default default invis

# filters
define-filter hide-preprint "(tags !# \"source-preprint\")"
define-filter show-opensource "(tags # \"access-open-access\")"
define-filter sections "(tags # \"section\")"
