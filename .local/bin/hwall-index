#!/usr/bin/env bash
# ~/.local/bin/hwall-index (v8 - Smart Path)

# --- Configuration ---
CONFIG_FILE="$HOME/.config/hwall/config"
CACHE_DIR="$HOME/.cache/hwall"
MANIFEST_FILE="$CACHE_DIR/manifest.txt"
TARGET_PATH="$1" # The directory to index is the first argument.

# --- Smart Path Logic ---
# If no path was provided as an argument, get it from the config file.
if [[ -z "$TARGET_PATH" ]]; then
    echo "ℹ️ No path provided. Reading path from config file..."
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "Error: Config file not found at $CONFIG_FILE"
        exit 1
    fi
    TARGET_PATH=$(grep '^path=' "$CONFIG_FILE" | cut -d'=' -f2-)
fi

# --- Validation ---
if [[ -z "$TARGET_PATH" ]]; then
    echo "Error: Could not determine a path to index from arguments or config file."
    exit 1
fi
if [[ ! -d "$TARGET_PATH" ]]; then
    echo "Error: Directory '$TARGET_PATH' not found."
    exit 1
fi

# --- Dependency Checks ---
if ! command -v identify &> /dev/null || ! command -v bc &> /dev/null; then
    echo "Error: Missing dependencies. Please ensure 'identify' (ImageMagick) and 'bc' are installed."
    exit 1
fi

# --- Indexing Logic ---
echo "🔎 Indexing wallpapers in '$TARGET_PATH'..."
mkdir -p "$CACHE_DIR"
touch "$MANIFEST_FILE"
TEMP_MANIFEST=$(mktemp)

# Remove any old entries for this specific path from the master manifest.
grep -v "\"$TARGET_PATH" "$MANIFEST_FILE" > "$TEMP_MANIFEST"

# Find images and append their new, more detailed data to our temp file.
find "$TARGET_PATH" -type f \( \
    -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o \
    -iname '*.bmp' -o -iname '*.webp' \
    \) -print0 | while IFS= read -r -d '' img; do
        read -r img_w img_h < <(identify -ping -format "%w %h" "$img")
        if [[ "$img_w" -gt 0 && "$img_h" -gt 0 ]]; then
            PIXELS=$((img_w * img_h))
            ASPECT_RATIO=$(echo "scale=4; $img_w / $img_h" | bc)
            printf "%s %s %s %s \"%s\"\n" "$img_w" "$img_h" "$ASPECT_RATIO" "$PIXELS" "$img" >> "$TEMP_MANIFEST"
        fi
done

mv "$TEMP_MANIFEST" "$MANIFEST_FILE"
echo "✅ Indexing complete for '$TARGET_PATH'."
