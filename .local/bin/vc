#!/usr/bin/expect --

# This script handles VPN, SSH, SCP, and VNC tunnel workflows for the
# University of Michigan Great Lakes cluster.
#
# Secrets expected in secret-tool:
#   secret-tool store --label="UNIQNAME" service uniqname
#   secret-tool store --label="UM login" service umlogin
#   secret-tool store --label="user" service user
#
# Notes:
#   - "user" is used for sudo on your local machine.
#   - "uniqname" and "umlogin" are used for U-M / Great Lakes auth.

set timeout 120
match_max 100000

# Procedure to retrieve a secret from secret-tool
proc get_secret {service_name label} {
    set secret ""
    if {[catch {exec secret-tool lookup service $service_name} secret]} {
        puts "Error: Could not retrieve $label from secret-tool."
        puts "Please run: secret-tool store --label=\"$label\" service $service_name"
        exit 1
    }

    set secret [string trim $secret]
    if {$secret eq ""} {
        puts "Error: Retrieved empty value for $label from secret-tool."
        puts "Please re-store it with: secret-tool store --label=\"$label\" service $service_name"
        exit 1
    }

    return $secret
}

# Print detailed usage information
proc print_usage {script_path} {
    set script_name [file tail $script_path]
    puts "Usage: $script_name <command> \[arguments]"
    puts ""
    puts "Description:"
    puts "  Manage VPN, SSH, VNC tunnels, and file transfers for U-M Great Lakes."
    puts ""
    puts "Commands:"
    puts "  -vc             Connect to the UM VPN."
    puts "  -vd             Disconnect from the UM VPN."
    puts "  -s              Open an SSH session to the Great Lakes login node."
    puts "  -i \"ssh_cmd\"    Establish an SSH tunnel and launch a VNC viewer."
    puts "                  Example: $script_name -i \"ssh -f -N -L 22595:gl-login-node:5901 <uniqname>@greatlakes.arc-ts.umich.edu\""
    puts "  -f              Fetch the '~/greatlakes' directory from Great Lakes transfer node."
    puts "  -p              Push the local '~/greatlakes' directory to Great Lakes transfer node."
    puts "  -h, --help      Display this help message."
    puts ""
    puts "Prerequisites:"
    puts "  openconnect, openssh, scp, expect, libsecret/secret-tool, gnome-keyring, tigervnc."
}

# Wait for openconnect to fully daemonize. The important fix is that we do not
# return merely on "Configured as ...". In the working terminal flow,
# openconnect is not fully detached until "Continuing in background; pid ...".
proc connect_vpn {sudo_password username vpn_password} {
    set configured 0

    puts "Attempting VPN connection..."
    spawn sudo openconnect umvpn.umnet.umich.edu/umvpn-all-traffic-alt --useragent=AnyConnect --disable-ipv6 --background

    expect {
        -re {\[sudo\] password for [^:]+:} {
            send -- "$sudo_password\r"
            exp_continue
        }
        "Username:" {
            send -- "$username\r"
            exp_continue
        }
        "Password:" {
            send -- "$vpn_password\r"
            exp_continue
        }
        -re {Configured as [^\r\n]+} {
            set configured 1
            exp_continue
        }
        -re {Continuing in background; pid [0-9]+} {
            puts "\n>>> VPN connected and backgrounded. Returning to terminal."
            # Give routes/interfaces a brief moment to settle, but do not wait
            # forever for EOF from the daemonized parent process.
            expect -timeout 3 eof
            return
        }
        eof {
            if {$configured} {
                puts "\n>>> VPN reported that it was configured, but the backgrounding line was not seen."
                puts ">>> Check with: pgrep -a openconnect"
                return
            } else {
                puts "\nError: openconnect exited before the VPN was configured."
                exit 1
            }
        }
        timeout {
            if {$configured} {
                puts "\nError: VPN configured, but openconnect did not finish backgrounding."
                puts "Try disconnecting with '$::argv0 -vd' and reconnecting."
            } else {
                puts "\nError: Timed out before VPN connection was configured."
            }
            exit 1
        }
    }
}

# Gracefully kill openconnect. Handles both cached sudo and sudo password prompt.
proc disconnect_vpn {sudo_password} {
    puts "Attempting VPN disconnection..."
    spawn sudo pkill -SIGINT openconnect

    expect {
        -re {\[sudo\] password for [^:]+:} {
            send -- "$sudo_password\r"
            exp_continue
        }
        eof {
            puts "VPN disconnected."
            return
        }
        timeout {
            puts "\nError: Timed out while trying to disconnect VPN."
            exit 1
        }
    }
}

# Shared SSH/SCP auth handler.
# - Accepts unknown host key if prompted.
# - Sends password when prompted.
# - Sends a blank Okta passcode to initiate push, then gives control to you so
#   you can read the number challenge, approve on your phone, and press Enter.
proc authenticate_remote {password {handoff_after_okta 1}} {
    expect {
        "Are you sure you want to continue connecting*" {
            send -- "yes\r"
            puts "\nAccepted host key."
            exp_continue
        }
        "*assword:*" {
            send -- "$password\r"
            puts "\nPassword sent."
            exp_continue
        }
        "*Okta passcode*" {
            send -- "\r"
            puts "\n>>> Okta push initiated. Approve the number challenge, then press Enter if prompted."
            if {$handoff_after_okta} {
                interact
                return "interacted"
            } else {
                exp_continue
            }
        }
        "*passcode*" {
            send -- "\r"
            puts "\n>>> Okta push initiated. Approve the number challenge, then press Enter if prompted."
            if {$handoff_after_okta} {
                interact
                return "interacted"
            } else {
                exp_continue
            }
        }
        eof {
            return "eof"
        }
        timeout {
            puts "\nError: Timed out while waiting for SSH/SCP authentication prompt."
            puts "Hints: confirm VPN is active with 'pgrep -a openconnect' and test reachability with: ssh -v <uniqname>@greatlakes.arc-ts.umich.edu"
            exit 1
        }
    }
}

# Check if an SSH tunnel already exists.
# Returns 1 if tunnel exists, 0 otherwise.
proc check_tunnel_exists {local_port} {
    set search_pattern "ssh -f -N -L ${local_port}:"
    set cmd "pgrep -f \"$search_pattern\""

    if {[catch {exec sh -c $cmd} result]} {
        return 0
    }

    if {[string trim $result] ne ""} {
        return 1
    }

    return 0
}

# Check if vncviewer is already running with the specified local port.
# Returns 1 if vncviewer exists, 0 otherwise.
proc check_vncviewer_exists {local_port} {
    set cmd "pgrep -f \"vncviewer localhost:$local_port\""

    if {[catch {exec sh -c $cmd} result]} {
        return 0
    }

    if {[string trim $result] ne ""} {
        return 1
    }

    return 0
}

# Check if at least one argument is provided.
if {$argc == 0} {
    print_usage $argv0
    exit 1
}

set command [lindex $argv 0]

if {[string equal $command "-h"] || [string equal $command "--help"]} {
    print_usage $argv0
    exit 0
}

# Retrieve secrets.
set username [get_secret "uniqname" "UNIQNAME"]
set password [get_secret "umlogin" "UM login"]
set user [get_secret "user" "user"]

switch -- $command {
    "-vc" {
        connect_vpn $user $username $password
    }

    "-vd" {
        disconnect_vpn $user
    }

    "-s" {
        set hostname "greatlakes.arc-ts.umich.edu"
        puts "Attempting SSH connection to $hostname..."

        spawn ssh -o ConnectTimeout=45 $username@$hostname
        set auth_result [authenticate_remote $password 1]

        # Usually authenticate_remote hands off to interact after the Okta prompt.
        # This fallback covers unusual cases where auth completed without Okta.
        if {$auth_result ne "interacted" && $auth_result ne "eof"} {
            interact
        }
    }

    "-i" {
        if {$argc < 2} {
            puts "Error: -i command requires an SSH command string as an argument."
            puts "Example: vc -i \"ssh -f -N -L 22595:gl3428.arc-ts.umich.edu:5901 smanzoor@greatlakes.arc-ts.umich.edu\""
            exit 1
        }

        set ssh_command [lindex $argv 1]
        set local_port ""

        if {![regexp -- {-L\s+(\d+):} $ssh_command match local_port]} {
            puts "Error: Could not extract local port from the SSH command."
            puts "Expected format in command: -L local_port:hostname:remote_port"
            exit 1
        }

        set vnc_running [check_vncviewer_exists $local_port]
        set tunnel_exists [check_tunnel_exists $local_port]

        if {$vnc_running} {
            puts "VNC viewer is already running for localhost:$local_port. Exiting."
            exit 0
        } elseif {$tunnel_exists} {
            puts "SSH tunnel already exists. Skipping tunnel creation."
            puts "Launching VNC viewer for localhost:$local_port."
            if {[catch {exec vncviewer localhost:$local_port &}]} {
                puts "Error: Could not launch vncviewer. Is it installed and in your PATH?"
            }
        } else {
            puts "Neither VNC viewer nor SSH tunnel found. Attempting to establish SSH tunnel..."
            puts "Executing: $ssh_command"

            spawn {*}$ssh_command
            authenticate_remote $password 1

            puts "\nAuthentication complete. Waiting for tunnel to stabilize..."
            sleep 2

            puts "Launching VNC viewer for localhost:$local_port."
            if {[catch {exec vncviewer localhost:$local_port &}]} {
                puts "Error: Could not launch vncviewer. Is it installed and in your PATH?"
            }
        }
    }

    "-f" {
        exec /bin/sh -c "mkdir -p ~/greatlakes"

        puts "Fetching files from greatlakes-xfer..."
        set hostname "greatlakes-xfer.arc-ts.umich.edu"
        spawn scp -r "${username}@${hostname}:./greatlakes" "$env(HOME)/"
        authenticate_remote $password 1
    }

    "-p" {
        puts "Pushing local ~/greatlakes directory to greatlakes-xfer..."
        set hostname "greatlakes-xfer.arc-ts.umich.edu"
        spawn scp -r "$env(HOME)/greatlakes" "${username}@${hostname}:."
        authenticate_remote $password 1
    }

    default {
        puts "Error: Unknown command '$command'.\n"
        print_usage $argv0
        exit 1
    }
}
