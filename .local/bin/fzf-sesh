#!/usr/bin/env bash
set -euo pipefail
command -v sesh >/dev/null || { echo 'Install sesh first (see README).' >&2; exit 1; }
picker=(fzf --height=80% --reverse)
if [[ -n ${TMUX:-} ]]; then
    picker=(fzf-tmux -p "85%,75%" -- --reverse)
fi
selection=$(sesh list | "${picker[@]}" --no-sort \
    --prompt='sesh > ' --header='Enter: connect | Esc: cancel' \
    --preview='sesh preview {}') || exit 0
[[ -n $selection ]] && exec sesh connect "$selection"
