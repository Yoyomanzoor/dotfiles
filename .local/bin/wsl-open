#!/usr/bin/env python3
"""Open a URL or a Linux file with the Windows default application."""
import base64
import pathlib
import re
import subprocess
import sys

if len(sys.argv) != 2:
    sys.exit("usage: wsl-open URL|FILE")
target = sys.argv[1]
try:
    if not re.match(r"^(https?|mailto):", target, re.I):
        path = pathlib.Path(target).expanduser().resolve()
        if not path.exists():
            sys.exit(f"File does not exist: {path}")
        target = subprocess.check_output(["wslpath", "-w", str(path)], text=True).strip()
    # Encode user data separately; never interpolate a path into PowerShell code.
    payload = base64.b64encode(target.encode("utf-8")).decode("ascii")
    script = "$target = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + payload + "')); Start-Process -FilePath $target"
    encoded = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
    sys.exit(subprocess.run([
        "powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive",
        "-EncodedCommand", encoded,
    ]).returncode)
except FileNotFoundError as error:
    sys.exit(f"WSL interoperability unavailable: {error}")
